<?xml version="1.0" encoding="utf-8"?>
<!--
  桌面小组件：封面 + 歌名 / 歌手 / 当前歌词 + 三个控制键。
  只用 RemoteViews 支持的原生控件与属性；文案、封面、播放态由 PlayerWidgetProvider 填充。
  上半块用 weight 占满剩余高度并垂直居中，控制键钉在底部，组件被拉高时不会挤成一团。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_cover"
            android:layout_width="68dp"
            android:layout_height="68dp"
            android:background="@drawable/widget_cover_bg"
            android:clipToOutline="true"
            android:contentDescription="@string/widget_cover_desc"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_idle_title"
                android:textColor="#FFFFFFFF"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/widget_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/widget_idle_subtitle"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/widget_lyric"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#8FFFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="10dp"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_prev"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_control_bg"
            android:contentDescription="@string/widget_prev_desc"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_prev" />

        <ImageButton
            android:id="@+id/widget_play"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginHorizontal="20dp"
            android:background="@drawable/widget_control_primary_bg"
            android:contentDescription="@string/widget_play_desc"
            android:padding="12dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_play" />

        <ImageButton
            android:id="@+id/widget_next"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_control_bg"
            android:contentDescription="@string/widget_next_desc"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_widget_next" />
    </LinearLayout>
</LinearLayout>
